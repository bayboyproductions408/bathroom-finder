# signing material and secrets — never commit
android/keystore.properties
android/upload-keystore.jks
android/*.jks
certs/
.env

# generated native projects — 'npx cap add ios|android' recreates these in CI,
# so they are never committed. The signing material inside android/ is ignored
# separately above and must survive.
/ios/
/android/app/
/android/build.gradle
/android/gradle.properties
/android/settings.gradle
/android/gradlew
/android/gradlew.bat
/android/gradle/
/android/capacitor.settings.gradle
/android/variables.gradle

# generated / local state
data/
ledger.json
node_modules/
android/.gradle/
android/build/
android/app/build/
*.log
